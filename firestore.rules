rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Document ID is a normalized-email-derived key (see /api/waitlist),
    // not an auto-ID. That's load-bearing for duplicate-signup protection:
    // a first signup for an address is a "create" (allowed); a repeat
    // signup targets the same document ID, which Firestore classifies as
    // an "update" — denied below — so it's rejected without needing any
    // read/list permission to check for existing entries first.
    match /waitlist/{document} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Lightweight email-only newsletter opt-ins (the "Subscribe" box on
    // /newsletter, /articles, etc.) — kept separate from /waitlist so
    // placeholder names never mix into the real applicant list.
    match /newsletterSubscribers/{document} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Live poll vote tallies. One document per poll, keyed by poll id.
    // Publicly readable so results can be shown before/without voting.
    // Writes are unauthenticated (this site has no visitor auth system,
    // matching the /waitlist rule above) but are constrained to look like
    // a legitimate single-vote increment: totalVotes may only ever go up
    // by exactly one per write, and the document shape is locked down so
    // a request can't rewrite arbitrary fields or fabricate a large total.
    match /pollVotes/{pollId} {
      allow read: if true;
      allow delete: if false;

      allow create: if request.resource.data.keys().hasOnly(['optionVotes', 'totalVotes', 'seededAt', 'updatedAt'])
        && request.resource.data.optionVotes is map
        && request.resource.data.totalVotes is int
        && request.resource.data.totalVotes >= 0;

      allow update: if request.resource.data.keys().hasOnly(['optionVotes', 'totalVotes', 'seededAt', 'updatedAt'])
        && request.resource.data.optionVotes is map
        && request.resource.data.totalVotes is int
        && request.resource.data.totalVotes == resource.data.totalVotes + 1;
    }
  }
}
